#!/usr/bin/env python3
# SPDX-License-Identifier: MIT
"""Compatibility entry point for the fork's manual Arch package update route.

The upstream automatic updater selected a different project's binaries. Keep the
entry point used by older addon configurations, without downloading or installing
those packages. Release checks require the explicit --check operation;
a background call is intentionally silent and has no side effects.
"""

import argparse
import json
import platform
import re
import urllib.error
import urllib.parse
import urllib.request

PROJECT_VERSION = "@WETYPE_OMARCHY_VERSION@"
PROJECT_REPOSITORY = "https://github.com/eddieqiu79/wetypex-omarchy"
UPDATE_GUIDE = PROJECT_REPOSITORY + "/blob/main/docs/UPDATES.md"
REPOSITORY = "eddieqiu79/wetypex-omarchy"
RUNTIME_VERSION = "@PROJECT_VERSION@"


def version_key(value):
    match = re.fullmatch(r"(0|[1-9]\d*)\.(0|[1-9]\d*)\.(0|[1-9]\d*)(?:(-dev)|-rc\.([1-9]\d*))?", value)
    if not match:
        raise ValueError("invalid version")
    major, minor, patch, dev, rc = match.groups()
    return int(major), int(minor), int(patch), 0 if dev else 1 if rc else 2, int(rc or 0)


class SafeRedirect(urllib.request.HTTPRedirectHandler):
    def redirect_request(self, request, fp, code, msg, headers, newurl):
        target = urllib.parse.urlsplit(newurl)
        if target.scheme != "https" or target.hostname not in {
            "github.com", "release-assets.githubusercontent.com", "objects.githubusercontent.com"}:
            raise ValueError("unexpected redirect")
        return super().redirect_request(request, fp, code, msg, headers, newurl)


def fetch_json(url):
    request = urllib.request.Request(url, headers={"User-Agent": "wetypex-omarchy-release-check",
                                                 "Accept": "application/json"})
    with urllib.request.build_opener(SafeRedirect()).open(request, timeout=15) as response:
        data = response.read(2 * 1024 * 1024 + 1)
    if len(data) > 2 * 1024 * 1024:
        raise ValueError("oversized metadata")
    return json.loads(data)


def validate_manifest(manifest, tag):
    version = tag[1:]
    version_key(version)
    if not isinstance(manifest, dict) or any((
        manifest.get("schema") != 1, manifest.get("repository") != REPOSITORY,
        manifest.get("tag") != tag, manifest.get("version") != version,
        manifest.get("architecture") != "x86_64",
        manifest.get("channel") != ("preview" if "-rc." in version else "stable"),
        not re.fullmatch(r"[a-f0-9]{40}", str(manifest.get("commit", ""))),
    )):
        raise ValueError("release manifest identity mismatch")
    package = manifest.get("package", {})
    expected_version = "1:" + version.replace("-rc.", "rc") + "-1"
    if (not isinstance(package, dict) or
        not re.fullmatch(r"wetypex-omarchy-[A-Za-z0-9._+-]+-x86_64\.pkg\.tar\.zst", str(package.get("name", ""))) or
        not re.fullmatch(r"[a-f0-9]{64}", str(package.get("sha256", ""))) or
        type(package.get("size")) is not int or package["size"] <= 0 or
        package.get("pacman_version") != expected_version):
        raise ValueError("invalid package metadata")
    return package


def check_releases(channel, current, runtime, architecture):
    if architecture != "x86_64":
        return {"status": "unsupported-architecture", "architecture": architecture}
    releases = []
    for page in range(1, 11):
        batch = fetch_json(f"https://api.github.com/repos/{REPOSITORY}/releases?per_page=100&page={page}")
        if not isinstance(batch, list):
            raise ValueError("invalid release response")
        releases.extend(batch)
        if len(batch) < 100:
            break
    else:
        raise ValueError("release listing incomplete")
    candidates = []
    for release in releases:
        if not isinstance(release, dict):
            raise ValueError("invalid release entry")
        if release.get("draft") or (channel == "stable" and release.get("prerelease")):
            continue
        tag = release.get("tag_name", "")
        if not isinstance(tag, str) or not re.fullmatch(r"v\d+\.\d+\.\d+(?:-rc\.[1-9]\d*)?", tag):
            continue
        if bool(release.get("prerelease")) != ("-rc." in tag):
            raise ValueError("release channel/tag mismatch")
        candidates.append((version_key(tag[1:]), release))
    if not candidates:
        return {"status": "no-release", "channel": channel}
    _, release = max(candidates, key=lambda item: item[0])
    tag = release["tag_name"]
    if release.get("immutable") is not True:
        return {"status": "release-not-immutable", "tag": tag}
    base = PROJECT_REPOSITORY + "/releases/download/" + tag + "/"
    assets = release.get("assets", [])
    if not isinstance(assets, list) or any(not isinstance(a, dict) for a in assets):
        raise ValueError("invalid release assets")
    by_name = {a.get("name"): a for a in assets}
    if by_name.get("release-manifest.json", {}).get("browser_download_url") != base + "release-manifest.json":
        raise ValueError("missing or unexpected manifest asset")
    manifest = fetch_json(base + "release-manifest.json")
    package = validate_manifest(manifest, tag)
    asset = by_name.get(package["name"], {})
    if asset.get("browser_download_url") != base + package["name"] or asset.get("size") != package["size"]:
        raise ValueError("package asset mismatch")
    result = {"tag": tag, "version": manifest["version"], "commit": manifest["commit"],
              "release_url": PROJECT_REPOSITORY + "/releases/tag/" + tag,
              "package": package, "channel": manifest["channel"],
              "cryptographically_verified": False,
              "next_step": "Verify release and downloaded assets with gh before any installation"}
    if manifest.get("runtime_version") != runtime:
        result["status"] = "runtime-review-required"
        return result
    try:
        local = version_key(current)
    except ValueError:
        result["status"] = "installed-version-unknown"
        return result
    remote = version_key(manifest["version"])
    result["status"] = "available" if remote > local else "current" if remote == local else "installed-newer"
    return result


def main(argv=None):
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--status", action="store_true",
                        help="Print the local update policy as JSON (no network request).")
    parser.add_argument("--force", action="store_true",
                        help="Compatibility option: explain the manual update route; do not download.")
    parser.add_argument("--check", action="store_true", help="Explicitly check this fork's immutable releases; never install.")
    parser.add_argument("--channel", choices=("stable", "preview"), default="stable")
    parser.add_argument("--current-version", default=PROJECT_VERSION, help="Override current version for source-checkout diagnostics only.")
    args = parser.parse_args(argv)
    if args.check:
        try:
            result = check_releases(args.channel, args.current_version, RUNTIME_VERSION, platform.machine())
        except (OSError, ValueError, TypeError, KeyError, urllib.error.URLError):
            # Never print redirect/signed URLs, response bodies or credentials.
            print(json.dumps({"status": "check-failed", "reason": "Network, rate limit or invalid release metadata; current version is not established"}))
            return 1
        print(json.dumps(result))
    elif args.status:
        print(json.dumps({
            "project": "wetypex-omarchy",
            "project_version": PROJECT_VERSION,
            "update_mode": "manual-arch-package",
            "automatic_updates": False,
            "release_check_performed": False,
            "repository": PROJECT_REPOSITORY,
            "instructions": UPDATE_GUIDE,
            "release_discovery": "explicit --check; stable by default",
        }))
    elif args.force:
        print("WeTypeX Omarchy uses reviewed Arch package updates.")
        print("No release check, download, installation or restart was performed.")
        print("Do not replace this fork with original WeTypeX release packages.")
        print(UPDATE_GUIDE)
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
